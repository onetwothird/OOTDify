{
  "expo": {
    "name": "Penggi",
    "slug": "penggi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ootdify",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.ootdify.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#253B64"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F4"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Penggi uses the camera only when you tap Scan Me, to take a full-body photo for AI body analysis and virtual try-on."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Penggi uses your location only to show your current city in the app header."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Penggi accesses your photos only for the profile picture you choose.",
          "cameraPermission": "Penggi uses the camera only for the profile picture you choose to take."
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Penggi uses Face ID only to unlock the app when you turn on biometric unlock."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3A5A96"
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.ootdify.app"
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "45afae54-11b9-4b22-a98c-685b081bd30d"
      }
    },
    "owner": "ootdify"
  }
}
