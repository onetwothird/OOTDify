{
  "expo": {
    "name": "ootdify",
    "slug": "ootdify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ootdify-icon.png",
    "scheme": "ootdify",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.ootdify.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F4"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "OOTDify uses the camera only when you tap Scan Me, to take a full-body photo for AI body analysis and virtual try-on."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OOTDify uses your location only to show your current city in the app header."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OOTDify accesses your photos only for the profile picture you choose.",
          "cameraPermission": "OOTDify uses the camera only for the profile picture you choose to take."
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OOTDify uses Face ID only to unlock the app when you turn on biometric unlock."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3A5A96"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.ootdify.app"
    }
  }
}
