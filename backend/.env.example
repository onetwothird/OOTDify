# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Flask ---
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=replace-me-with-a-long-random-string

# --- Uploads ---
MAX_CONTENT_LENGTH=10485760

# --- CORS ---
CORS_ORIGINS=*

# --- YOLO ---
# Leave MODEL_PATH pointing at models/yolo/ so weights stay inside the repo folder.
YOLO_MODEL_PATH=models/yolo/yolo11n.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU=0.45
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=cpu
MODEL_LOAD_ON_STARTUP=1

# --- Pose (auto-downloads yolov8n-pose.pt on first run) ---
POSE_MODEL_PATH=models/yolo/yolov8n-pose.pt
POSE_CONF_THRESHOLD=0.25
POSE_IOU=0.45
POSE_IMAGE_SIZE=640
POSE_DEVICE=cpu

# --- Segmentation (auto-downloads yolov8n-seg.pt on first run) ---
SEG_MODEL_PATH=models/yolo/yolov8n-seg.pt
SEG_CONF_THRESHOLD=0.25
SEG_IOU=0.45
SEG_IMAGE_SIZE=640
SEG_DEVICE=cpu

# --- Try-on job system ---
# Put real model weights here to plug in a VTON model; empty = honest failure.
TRYON_MODEL_PATH=
TRYON_POLL_INTERVAL=5
TRYON_WORKER_ENABLED=1

# --- Supabase (BACKEND-ONLY secrets — never expose these to the Expo app) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# How long signed URLs for private images stay valid (seconds); default 15 min.
SIGNED_URL_EXPIRY_SECONDS=900

# --- Rate limiting (per user, sliding window) ---
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_UPLOAD_MAX=15
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_ACCOUNT_MAX=10
RATE_LIMIT_ACCOUNT_WINDOW=3600

# --- Future / optional third-party services (documented placeholders) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=