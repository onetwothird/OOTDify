# Copy this file to .env.local and fill in real values.
# Both .env and .env.local are gitignored — never commit real secrets.

# --- Supabase (PUBLIC / publishable keys only — safe for the Expo client) ---
# These are used to talk to Supabase directly from the app (auth, catalog).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Flask / AI backend base URL ---
# Which URL the app uses depends on where you run Expo:
#   * Physical phone (Android/iOS over Wi-Fi): your PC's LAN IPv4.
#       Find it with `ipconfig` → "IPv4 Address" (e.g. 192.168.1.50).
#       -> EXPO_PUBLIC_API_URL=http://192.168.1.50:5000
#   * Android emulator: the emulator reaches your PC via 10.0.2.2.
#       -> EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#   * iOS simulator / Web browser (same machine as Flask):
#       -> EXPO_PUBLIC_API_URL=http://localhost:5000
# If this var is left empty on a physical phone, the app tries to derive the
# dev machine's LAN IP automatically from Metro's host (works in most setups).
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000